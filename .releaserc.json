{
  "branches": ["main"],
  "plugins": [
    ["@semantic-release/commit-analyzer", { "preset": "conventionalcommits" }],
    ["@semantic-release/release-notes-generator", { "preset": "conventionalcommits" }],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "sed -i 's/\"version\": \".*\"/\"version\": \"${nextRelease.version}\"/' custom_components/daylight/manifest.json"
      }
    ],
    ["@semantic-release/git", { "assets": ["custom_components/daylight/manifest.json"] }],
    "@semantic-release/github"
  ]
}
